{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShowMarket Product or Service",
  "description": "Skema data katalog awal. Ini bukan daftar produk nyata dan tidak berisi harga rekaan.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "businessUnit",
    "type",
    "name",
    "category",
    "publicationStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "businessUnit": {
      "enum": [
        "APP",
        "SND",
        "ASM"
      ]
    },
    "type": {
      "enum": [
        "product",
        "service"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "shortDescription": {
      "type": [
        "string",
        "null"
      ]
    },
    "specifications": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "sourcePartner": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "sourceCheckedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "price": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "priceSource": {
      "type": [
        "string",
        "null"
      ]
    },
    "availability": {
      "type": [
        "string",
        "null"
      ]
    },
    "marketplaceUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "permissionStatus": {
            "enum": [
              "unknown",
              "approved",
              "not-allowed"
            ]
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "url",
          "alt",
          "permissionStatus"
        ]
      }
    },
    "partnerRelationshipVerified": {
      "type": "boolean",
      "default": false
    },
    "inquiryEnabled": {
      "type": "boolean",
      "default": false
    },
    "publicationStatus": {
      "enum": [
        "draft",
        "review",
        "published"
      ]
    }
  },
  "additionalProperties": false
}
